# ClashMetaForAndroid 环境配置
# 复制此文件为 .env 并修改为你自己的配置

# ================ 签名配置 ================
# 用于 APK 签名，CI 会使用这些值生成 keystore
SIGNING_STORE_PASSWORD=ojbkxc
SIGNING_KEY_ALIAS=ojbkxc
SIGNING_KEY_PASSWORD=ojbkxc

# ================ 前端域名配置 ================
# V2Board 前端域名，不带 https:// 前缀
V2BOARD_SERVER_URL=jc.lxseek.com
V2BOARD_SERVER_DOMAINS=jc.lxseek.com,go.lxkjzh.top,cdn.lxkjzh.top
