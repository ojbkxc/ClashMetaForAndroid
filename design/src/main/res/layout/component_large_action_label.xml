<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/large_item_header_margin_horizontal"
        android:paddingVertical="@dimen/large_item_padding_vertical">

        <View
            android:id="@+id/icon_view"
            android:layout_width="@dimen/large_item_header_component_size"
            android:layout_height="@dimen/large_item_header_component_size"
            android:layout_marginEnd="@dimen/large_item_header_margin_horizontal" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- 第一行：运行中文字 -->
            <TextView
                android:id="@+id/text_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body1" />

            <!-- 第二行：流量信息（上传下载上下排列） -->
            <LinearLayout
                android:id="@+id/traffic_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="start"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/traffic_upload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/traffic_download"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- subtext（用于其他卡片） -->
            <TextView
                android:id="@+id/subtext_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/large_item_text_margin"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
        </LinearLayout>

        <!-- 右侧：套餐信息和日期（靠右对齐） -->
        <LinearLayout
            android:id="@+id/trailing_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 套餐名称（靠右） -->
            <TextView
                android:id="@+id/trailing_text_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:ellipsize="end"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- 到期日期（靠右） -->
            <TextView
                android:id="@+id/trailing_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- trailing_text（用于其他卡片，在文字行旁边） -->
        <TextView
            android:id="@+id/trailing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:visibility="gone" />
    </LinearLayout>
</layout>